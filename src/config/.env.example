# Sauce Demo Test Configuration
# This uses the Sauce Demo website which is perfect for testing login functionality

# Test website URL
BASE_URL=https://www.saucedemo.com/

# Test account credentials (standard user)
VALID_USERNAME=standard_user
VALID_PASSWORD=secret_sauce

# Locked out user (for testing error scenarios)
LOCKED_USER=locked_out_user

# Performance test user
PERF_USER=performance_glitch_user

# Problem user (for testing UI issues)
PROBLEM_USER=problem_user
